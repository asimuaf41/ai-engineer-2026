# Public base URL this app is served at (used for Next.js metadataBase).
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# "demo" = scripted replies, no key needed. "live" = real Claude (needs ANTHROPIC_API_KEY).
SHIPWRIGHT_AI_MODE=demo
# Server-only. Starts with sk-ant-. Leave empty in demo mode.
ANTHROPIC_API_KEY=

# Required. Signs tool approvals so a modified browser can't fake an "Approve" click.
# Generate one with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# Daily free-question quota (public demo). Optional: without Upstash the counts live in memory.
# Create a free Redis database from the Vercel Marketplace (Upstash); it fills these two in for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Mixed into the hash of each visitor's IP. Generate one with: openssl rand -base64 32
QUOTA_SALT=
# Free questions per person per day (default 5) and live answers for everyone per day (default 300).
DEMO_DAILY_LIMIT=5
DEMO_GLOBAL_DAILY_LIMIT=300
