# Public base URL this app is served at (used for Next.js metadataBase).
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# "demo" = scripted replies, no key needed. "live" = real Claude (needs ANTHROPIC_API_KEY).
SHIPWRIGHT_AI_MODE=demo
# Server-only. Starts with sk-ant-. Leave empty in demo mode.
ANTHROPIC_API_KEY=

# Required. Signs tool approvals so a modified browser can't fake an "Approve" click.
# Generate one with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# Daily free-question quota (public demo). Optional: without Upstash the counts live in memory.
# Create a free Redis database from the Vercel Marketplace (Upstash); it fills these two in for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Mixed into the hash of each visitor's IP. Generate one with: openssl rand -base64 32
QUOTA_SALT=
# Free questions per person per day (default 5) and live answers for everyone per day (default 300).
DEMO_DAILY_LIMIT=5
DEMO_GLOBAL_DAILY_LIMIT=300

# ---------------------------------------------------------------------------------------------
# Supabase (Day 14). Local stack first, hosted project second.
# Hosted project ref: hgdsfkwozcpeqkasklme  (https://supabase.com/dashboard/project/hgdsfkwozcpeqkasklme)
# Local: run `pnpm db:start`, then `pnpm db:status` and copy the publishable and secret keys it prints.
# Older CLIs call them anon / service_role. Hosted: Project Settings > API Keys in the dashboard.
# ---------------------------------------------------------------------------------------------
# API URL. Local: http://127.0.0.1:54321   Hosted: https://hgdsfkwozcpeqkasklme.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public on purpose (it ships to the browser). It is safe only because RLS is on every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS, so never use it in a client component or put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
# Where this app is served, used for sign-in redirects. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub App (later today). Leave empty until the app exists: the UI shows "coming soon" and nothing crashes.
# Numeric App ID, from the GitHub App settings page.
GITHUB_APP_ID=
# The app's URL name (github.com/apps/<slug>), used for the install link.
GITHUB_APP_SLUG=
# OAuth client id of the GitHub App (starts with Iv).
GITHUB_APP_CLIENT_ID=
# Server only. Client secret of the GitHub App.
GITHUB_APP_CLIENT_SECRET=
# Server only. The app's private key (.pem file) as one base64 line: base64 -i key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=

# Supabase OAuth app (later today), so users can connect their own Supabase project. Leave empty until it exists.
# Client id of the OAuth app (Supabase dashboard > Account > OAuth Apps).
SUPABASE_OAUTH_CLIENT_ID=
# Server only. Client secret of the OAuth app.
SUPABASE_OAUTH_CLIENT_SECRET=

# Server only. Signs the "state" value of both OAuth flows so a sign-in can't be forged. 32+ random bytes:
# openssl rand -base64 32
OAUTH_STATE_SECRET=
