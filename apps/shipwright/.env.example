# Public base URL this app is served at (used for Next.js metadataBase).
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# "demo" = scripted replies, no key needed. "live" = real Claude (needs ANTHROPIC_API_KEY).
SHIPWRIGHT_AI_MODE=demo
# Server-only. Starts with sk-ant-. Leave empty in demo mode.
ANTHROPIC_API_KEY=
