{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "types": ["node"],
    // Lets a test import "./safe-next.ts" with the extension, which Node's test runner needs. Safe here: nothing is emitted (noEmit).
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src", "e2e", "playwright.config.ts", "next.config.ts", ".next/types/**/*.ts"]
}
