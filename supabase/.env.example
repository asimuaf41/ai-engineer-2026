# Copy to supabase/.env (gitignored) and fill in. The Supabase CLI reads it for the env(...) values in config.toml.
# GitHub OAuth App used ONLY for "Continue with GitHub" (login). Create it at github.com > Settings > Developer settings > OAuth Apps.
# Authorization callback URL for the local stack: http://127.0.0.1:54321/auth/v1/callback  (the API URL from `pnpm db:status`)
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
