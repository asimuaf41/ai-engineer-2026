{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["ANTHROPIC_API_KEY", "NEXT_PUBLIC_APP_URL", "SHIPWRIGHT_AI_MODE", "SKIP_ENV_VALIDATION", "TOOL_APPROVAL_SECRET"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": ["SKIP_ENV_VALIDATION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
